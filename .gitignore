# ============================================
# GranaLab — .gitignore
# ============================================

# ---------- Variáveis de ambiente / segredos ----------
# NUNCA commite chaves de API (GEMINI_API_KEY, etc.)
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribuição / empacotamento
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testes e cobertura
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
nosetests.xml

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Node / JavaScript ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/
.yarn/
.pnp.*
.webpack/
dist-ssr/
*.local

# ---------- Banco de dados / dados locais ----------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
instance/
data/uploads/
uploads/
*.log

# ---------- Arquivos gerados / temporários ----------
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.Trash-*

# Documentos do Office / LibreOffice
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
*.odt
*.ods
*.odp
*.rtf
# Travas temporárias criadas pelo Word/LibreOffice ao abrir o arquivo
~$*
.~lock.*#

# ---------- Documentação ----------
docs/

# ---------- Editores / IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Ferramentas / agentes ----------
.claude/
.cursor/
.aider*
!.cursorrules
# Instruções locais de agentes de IA (não versionar)
AGENTS.md

